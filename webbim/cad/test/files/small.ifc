ISO-10303-21;
HEADER;
FILE_DESCRIPTION((''),'2;1');
FILE_NAME('small.ifc','2026-01-01T00:00:00',(''),(''),'','','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* units: millimetres, radians */
#1= IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
#2= IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);
#3= IFCUNITASSIGNMENT((#1,#2));

#10= IFCCARTESIANPOINT((0.,0.,0.));
#11= IFCDIRECTION((0.,0.,1.));
#12= IFCDIRECTION((1.,0.,0.));
#13= IFCAXIS2PLACEMENT3D(#10,#11,#12);
#14= IFCLOCALPLACEMENT($,#13);

#20= IFCPROJECT('0project0000000000000',$,'Small',$,$,$,$,$,#3);
#21= IFCSITE('0site00000000000000000',$,'Site',$,$,#14,$,$,.ELEMENT.,$,$,$,$,$);
#22= IFCBUILDING('0building00000000000',$,'Building',$,$,#14,$,$,.ELEMENT.,$,$,$);
#23= IFCBUILDINGSTOREY('0storey000000000000A',$,'Level 1',$,$,#14,$,$,.ELEMENT.,0.);
#24= IFCRELAGGREGATES('0agg1',$,$,$,#20,(#21));
#25= IFCRELAGGREGATES('0agg2',$,$,$,#21,(#22));
#26= IFCRELAGGREGATES('0agg3',$,$,$,#22,(#23));

/* a wall: 5000 long, 200 thick, 3000 high, as an extruded rectangle */
#30= IFCCARTESIANPOINT((0.,0.,0.));
#31= IFCAXIS2PLACEMENT3D(#30,#11,#12);
#32= IFCLOCALPLACEMENT(#14,#31);
#33= IFCCARTESIANPOINT((2500.,0.));
#34= IFCAXIS2PLACEMENT2D(#33,$);
#35= IFCRECTANGLEPROFILEDEF(.AREA.,'Wall',#34,5000.,200.);
#36= IFCEXTRUDEDAREASOLID(#35,#31,#11,3000.);
#37= IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#36));
#38= IFCPRODUCTDEFINITIONSHAPE($,$,(#37));
#39= IFCWALLSTANDARDCASE('0wall0000000000000AA',$,'Basic Wall:Generic 200',$,$,#32,#38,$,$);

/* an opening in it: 1000 x 2100, 1000 along */
#40= IFCCARTESIANPOINT((1000.,-150.,0.));
#41= IFCAXIS2PLACEMENT3D(#40,#11,#12);
#42= IFCLOCALPLACEMENT(#32,#41);
#43= IFCCARTESIANPOINT((500.,250.));
#44= IFCAXIS2PLACEMENT2D(#43,$);
#45= IFCRECTANGLEPROFILEDEF(.AREA.,'Hole',#44,1000.,500.);
#46= IFCEXTRUDEDAREASOLID(#45,#41,#11,2100.);
#47= IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#46));
#48= IFCPRODUCTDEFINITIONSHAPE($,$,(#47));
#49= IFCOPENINGELEMENT('0open0000000000000BB',$,'Opening',$,$,#42,#48,$,$);
#50= IFCRELVOIDSELEMENT('0voids',$,$,$,#39,#49);

/* a steel column: UC 305x305x97, 4000 tall, at (6000, 0) */
#60= IFCCARTESIANPOINT((6000.,0.,0.));
#61= IFCAXIS2PLACEMENT3D(#60,#11,#12);
#62= IFCLOCALPLACEMENT(#14,#61);
#63= IFCCARTESIANPOINT((0.,0.));
#64= IFCAXIS2PLACEMENT2D(#63,$);
#65= IFCISHAPEPROFILEDEF(.AREA.,'UC305x305x97',#64,305.3,307.9,9.9,15.4,15.2);
#66= IFCEXTRUDEDAREASOLID(#65,#61,#11,4000.);
#67= IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#66));
#68= IFCPRODUCTDEFINITIONSHAPE($,$,(#67));
#69= IFCCOLUMN('0col00000000000000CC',$,'UC305x305x97',$,$,#62,#68,$,$);

/* a slab with a hole in it, as an arbitrary profile with a void */
#70= IFCCARTESIANPOINT((0.,0.,3000.));
#71= IFCAXIS2PLACEMENT3D(#70,#11,#12);
#72= IFCLOCALPLACEMENT(#14,#71);
#73= IFCCARTESIANPOINT((0.,0.));
#74= IFCCARTESIANPOINT((8000.,0.));
#75= IFCCARTESIANPOINT((8000.,6000.));
#76= IFCCARTESIANPOINT((0.,6000.));
#77= IFCPOLYLINE((#73,#74,#75,#76,#73));
#78= IFCCARTESIANPOINT((2000.,2000.));
#79= IFCCARTESIANPOINT((4000.,2000.));
#80= IFCCARTESIANPOINT((4000.,4000.));
#81= IFCCARTESIANPOINT((2000.,4000.));
#82= IFCPOLYLINE((#78,#79,#80,#81,#78));
#83= IFCARBITRARYPROFILEDEFWITHVOIDS(.AREA.,'Slab',#77,(#82));
#84= IFCEXTRUDEDAREASOLID(#83,#71,#11,250.);
#85= IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#84));
#86= IFCPRODUCTDEFINITIONSHAPE($,$,(#85));
#87= IFCSLAB('0slab00000000000000D',$,'Floor 250',$,$,#72,#86,$,.FLOOR.);

/* a revolved solid: a quarter ring turned about Z */
#90= IFCCARTESIANPOINT((0.,0.,0.));
#91= IFCDIRECTION((0.,1.,0.));
#92= IFCAXIS2PLACEMENT3D(#90,#91,#12);
#93= IFCLOCALPLACEMENT(#14,#92);
#94= IFCCARTESIANPOINT((250.,20.));
#95= IFCAXIS2PLACEMENT2D(#94,$);
#96= IFCRECTANGLEPROFILEDEF(.AREA.,'Ring',#95,100.,40.);
#97= IFCCARTESIANPOINT((0.,0.,0.));
#98= IFCDIRECTION((0.,1.,0.));
#99= IFCAXIS1PLACEMENT(#97,#98);
#100= IFCREVOLVEDAREASOLID(#96,#92,#99,1.5707963267948966);
#101= IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#100));
#102= IFCPRODUCTDEFINITIONSHAPE($,$,(#101));
#103= IFCBUILDINGELEMENTPROXY('0proxy00000000000EE',$,'Turned ring',$,$,#93,#102,$,$);

#110= IFCRELCONTAINEDINSPATIALSTRUCTURE('0cont',$,$,$,(#39,#69,#87,#103),#23);
ENDSEC;
END-ISO-10303-21;
